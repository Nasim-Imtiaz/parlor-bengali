# AI proxy configuration
# Copy this file to .env and fill in real values:  cp .env.example .env
# The real .env is gitignored — never commit your API key.

# Base URL of an OpenAI-compatible provider (no trailing slash).
# The service calls  POST {AI_PROVIDER_BASE_URL}/chat/completions
# Examples:
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   http://localhost:11434/v1        (Ollama / local gateway)
AI_PROVIDER_BASE_URL=https://api.openai.com/v1

# API key / bearer token for the provider above. Required.
AI_API_KEY=sk-your-key-here

# Model name to request. Required.
AI_MODEL=gpt-4o-mini

# Port this proxy listens on (default: 3000 — kept off 8000 so it can run
# alongside the FastAPI app).
PORT=3000

# Outbound request timeout in milliseconds (default: 30000).
AI_REQUEST_TIMEOUT_MS=30000
