# Path to a local Gemma 4 E2B model (optional — auto-downloads from HuggingFace if not set)
# MODEL_PATH=/path/to/gemma-4-E2B-it.litertlm

# Server port (default: 8000)
# PORT=8000

# Optional: route AI replies through the standalone Node.js proxy (services/ai-proxy/)
# instead of the on-device model. When set, the local Gemma model is not loaded.
# AI_PROXY_URL=http://localhost:3000

# Timeout in seconds for the outbound proxy call (default: 30)
# AI_PROXY_TIMEOUT=30
